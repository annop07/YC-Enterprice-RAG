# --- LLM (OpenAI-compatible endpoint; KKU IntelSphere in this workspace) ---
OPENAI_API_KEY=sk_PASTE_YOUR_KEY_HERE
OPENAI_BASE_URL=https://gen.ai.kku.ac.th/api/v1

# Streaming chat model. Measured on the KKU proxy:
#   qwen3-next-80b-a3b-instruct  0.9s to first visible token   <- default
#   claude-haiku-4.5             1.7s, smooth 60-delta stream
#   qwen3.7-max                  18s  (reasoning model — do not use here)
#   gemini-3.6-flash             returns the whole answer in one delta
CHAT_MODEL=qwen3-next-80b-a3b-instruct

# --- Storage ---
# Host port 5433 to stay clear of a local Postgres on 5432 (see docker-compose.yml).
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# --- Embeddings ---
# EMBED_DIM must match the model, and changing either after documents exist is
# a re-index: the vector column width is fixed at table creation.
#   BAAI/bge-small-en-v1.5          dim 384   67 MB   English, fast   <- default
#   intfloat/multilingual-e5-large  dim 1024  2.2 GB  Thai / mixed corpora
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

#   Xenova/ms-marco-MiniLM-L-6-v2              80 MB   English         <- default
#   jinaai/jina-reranker-v2-base-multilingual  1.1 GB  Thai / mixed
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Chunking ---
# 400, not the 500-1000 in the brief: every multilingual model fastembed offers
# caps at 512 input tokens and truncates past that silently.
CHUNK_TOKENS=400
CHUNK_OVERLAP=80

# --- Retrieval ---
CANDIDATES_PER_LEG=50
FUSION_KEEP=20
TOP_K=5
RRF_K=60
